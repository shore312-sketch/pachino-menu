{
  "name": "pachino-menu",
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "pages_build_output_dir": ".vercel/output/static",
  "preview_urls": false,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pachino-menu",
      "database_id": "YOUR_DATABASE_ID_HERE"
    }
  ]
}
